{
  "name": "deltav-game",
  "private": true,
  "version": "1.0.0",
  "description": "델타-브이 실시간 3D 빌드. 소스는 여기, 산출물은 public/js/deltav-bundle.js 로 커밋한다.",
  "scripts": {
    "build": "esbuild src/main.js --bundle --minify --format=iife --target=es2019 --outfile=../../public/js/deltav-bundle.js",
    "watch": "esbuild src/main.js --bundle --format=iife --target=es2019 --outfile=../../public/js/deltav-bundle.js --watch"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  },
  "dependencies": {
    "@babylonjs/core": "^8.0.0",
    "@babylonjs/loaders": "^8.0.0"
  }
}
